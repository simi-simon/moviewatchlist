# MongoDB Connection String (Atlas or Local)
# Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/movie_watchlist
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ermdr2r.mongodb.net/movie_watchlist?retryWrites=true&w=majority

# Port and Host for the Express API server
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173
